# Copy this file to `.env` (already git-ignored) and fill in the real
# values. See `apis/` for the full API contract — `apis/environments-bsg8.md`
# for base URLs, `apis/authentication-process-3eUk.md` for both auth layers.

# Production per apis/environments-bsg8.md. Only override for local backend
# dev (e.g. PILATES_API_BASE_URL=http://localhost:8128).
PILATES_API_BASE_URL=http://56.228.38.227:8128

# Required — every request past /health 401s without it.
PILATES_API_KEY=

# Optional for now. The `X-App-Signature` layer (HMAC-SHA256) isn't enforced
# server-side yet (ENFORCE_APP_SIGNATURE=false), so requests work fine
# without this — but set it as soon as ops shares APP_SIGNATURE_SECRET so
# ApiClient starts signing every request and enforcement can flip on later
# with no app update needed.
PILATES_APP_SIGNATURE_SECRET=
